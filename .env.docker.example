# ==========================================================
# Django
# ==========================================================

# Generate a secure random key before the first startup.
SECRET_KEY="change-this-to-a-random-secret-key"

# Comma-separated list of allowed hosts.
ALLOWED_HOSTS=localhost,127.0.0.1,web

# Internal Django ASGI server.
# Docker Compose service name (do not change)
AS_HOST=web
AS_PORT=8000

# Required only when accessing the application over HTTPS.
# Example:
# CSRF_TRUSTED_ORIGINS=https://192.168.1.11
# CSRF_TRUSTED_ORIGINS=

# Enable only for development.
DEBUG=False

# If True, Django serves uploaded media files.
# Set to False when using Nginx or another reverse proxy.
SERVE_MEDIA=True

# Optional custom media directory.
# MEDIA_PATH=/path/to/media

# ==========================================================
# PostgreSQL
# ==========================================================

DB_NAME=analizzascontrini_db
DB_USER=analizzascontrini_user
DB_PASSWORD="change-this-password"
# Docker Compose service name (do not change)
DB_HOST=db
DB_PORT=5432

# ==========================================================
# Ollama
# ==========================================================

# Ollama server (must run outside Docker)
OLLAMA_HOST=http://192.168.1.50:11434

# Do NOT use:
# OLLAMA_HOST=http://localhost:11434
#
# Inside Docker, localhost refers to the container itself.
#
# The Ollama server must listen on all network interfaces:
# OLLAMA_HOST=0.0.0.0 ollama serve


# ==========================================================
# Redis
# ==========================================================
# Docker Compose service name (do not change)
REDIS_URL=redis://redis:6379/0


